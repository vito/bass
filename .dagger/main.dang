"""
The Bass scripting language (https://bass-lang.org).
"""
type Bass {
  """
  The workspace containing the Bass source.
  """
  let ws: Workspace!

  """
  Files go generate needs beyond what dagger.io/go discovers on its own.
  """
  let generateFiles: [String!]! = [
    "proto/*.proto",
    "pkg/proto/generate",
    "pkg/runtimes/bin/Makefile",
  ]

  """
  The Go toolchain for Bass: dagger.io/go's Go image, plus everything go
  generate and the tests need.

  The workspace's dagger.io/go uses this as its base (see dagger.toml), so its
  checks run the same codegen tools, can reach buildkitd, and have bass on
  $PATH for the LSP tests.
  """
  goBase: Container! {
    withBuildkit(base).withFile("/usr/bin/bass", build.file("bass"))
  }

  """
  The Go toolchain, without the buildkitd service binding.
  """
  let base: Container! {
    let arch = toString(defaultPlatform).split("/")[1]!
    let protocArch = if (arch == "arm64") { "aarch_64" } else { "x86_64" }
    go.module(ws, ".").base(ws)
      .withExec([
        "apk", "add", "--no-cache",
        "git",
        "make",
        "upx",
        "bash",
        "gcc",
        "musl-dev",
        "neovim",
        # for the upstream (glibc) protoc release below
        "gcompat",
        "libstdc++",
      ])
      # match the versions the committed pkg/proto/*.pb.go were generated with,
      # so go generate's stale checks are reproducible
      .withMountedFile(
        "/tmp/protoc.zip",
        http("https://github.com/protocolbuffers/protobuf/releases/download/v21.12/protoc-21.12-linux-${protocArch}.zip"),
      )
      .withExec(["unzip", "-o", "/tmp/protoc.zip", "-d", "/usr/local", "bin/*", "include/*"])
      .withExec([
        "go", "install",
        "google.golang.org/protobuf/cmd/protoc-gen-go@v1.30.0",
      ])
      .withExec([
        "go", "install",
        "google.golang.org/grpc/cmd/protoc-gen-go-grpc@v1.3.0",
      ])
      .withExec([
        "go", "install",
        # match golang.org/x/tools in go.mod; @latest wants a newer Go
        "golang.org/x/tools/cmd/stringer@v0.42.0",
      ])
      .withExec([
        "go", "install",
        "gotest.tools/gotestsum@latest",
      ])
  }

  let toolchain: Go! {
    go(base: base, includeExtraFiles: generateFiles)
  }

  """
  The workspace after go generate: protobufs, stringers, and the runtime shim
  binaries (pkg/runtimes/bin/exe.*) embedded by the Buildkit runtime.
  """
  let generated: Workspace! {
    ws.withChanges(toolchain.module(ws, ".").generate(ws))
  }

  """
  Build Bass binaries.
  """
  build(
    version: String! = "dev",
    goos: String,
    goarch: String,
  ): Directory! {
    # plain go build rather than dagger.io/go's package collection: a check
    # selection narrows that collection, which breaks goBase for go's checks
    let gws = generated
    let mod = toolchain.module(gws, ".")
    let host = toString(defaultPlatform).split("/")
    let name = if (goos == "windows") { "bass.exe" } else { "bass" }
    base
      .withMountedDirectory(mod.mountPath, mod.source(gws))
      .withWorkdir(mod.mountPath)
      .withEnvVariable("CGO_ENABLED", "0")
      .withEnvVariable("GOOS", goos ?? host[0]!)
      .withEnvVariable("GOARCH", goarch ?? host[1]!)
      .withExec([
        "go", "build",
        "-ldflags", "-X main.version=${version}",
        "-o", "/out/${name}",
        "./cmd/bass",
      ])
      .directory("/out")
  }

  """
  Start a REPL.
  """
  repl: Container! {
    container
      .from("alpine")
      .withExec(["apk", "add", "--no-cache", "bash"])
      .withFile("/usr/bin/bass", build.file("bass"))
      .withDefaultTerminalCmd(["bash"])
      .terminal
  }

  """
  Run unit tests.
  """
  unit(
    packages: [String!]! = ["./..."],
    goTestFlags: [String!]! = [],
  ): Void @check {
    gotestsum(
      testEnv(base),
      packages: packages,
      goTestFlags: goTestFlags + ["-short"],
    ).sync

    null
  }

  # TODO: move Dagger runtime back into this repo
  # """
  # Test Dagger runtime.
  # """
  # testDagger: Void @check {
  #   integration.sync
  #
  #   null
  # }

  """
  Test Buildkit runtime.
  """
  testBuildkit: Void @check {
    integration(runtime: "Buildkit").sync

    null
  }

  """
  Run integration tests.
  """
  integration(
    runtime: String! = "Dagger",
    goTestFlags: [String!]! = [],
  ): Container! {
    let integBase = base
      .withFile("/usr/bin/bass", build.file("bass"))
    if (runtime != "") {
      goTestFlags += ["-run", "Runtimes/" + runtime]
    }
    if (runtime != "Dagger") {
      integBase = withBuildkit(integBase)
    }
    gotestsum(
      testEnv(integBase),
      packages: ["./pkg/runtimes"],
      goTestFlags: goTestFlags,
    )
  }

  """
  Run unit tests (returns stdout).
  """
  runUnit: String! {
    gotestsum(
      testEnv(withBuildkit(base)),
      packages: ["./pkg/bass"],
    ).stdout
  }

  """
  Mount the generated source into a container, ready for go test.
  """
  let testEnv(ctr: Container!): Container! {
    let gws = generated
    let mod = toolchain.module(gws, ".")
    ctr
      .withMountedDirectory(
        mod.mountPath,
        mod.source(gws, test: true).withDirectory(".", mod.testData(gws)),
      )
      .withWorkdir(mod.mountPath)
  }

  let gotestsum(
    ctr: Container!,
    packages: [String!]!,
    goTestFlags: [String!]! = [],
  ): Container! {
    ctr.withExec(
      ["gotestsum", "--format", "testname", "--"] + goTestFlags + packages,
    )
  }

  let withBuildkit(ctr: Container!): Container! {
    ctr
      .withServiceBinding("bass-buildkitd", buildkitd)
      .withEnvVariable("BUILDKIT_HOST", "tcp://bass-buildkitd:1234")
  }

  let buildkitd: Service! {
    container
      .from("basslang/buildkit:9b0bdb600641f3dd1d96f54ac2d86581ab6433b2")
      .withMountedCache(
        "/var/lib/buildkit",
        cacheVolume("bass-buildkitd@2"),
      )
      .withExposedPort(1234)
      .withDefaultArgs([
        "dumb-init",
        "buildkitd",
        "--debug",
        "--addr=tcp://0.0.0.0:1234",
      ])
      .asService(insecureRootCapabilities: true)
  }

  """
  Start a dev container.
  """
  devContainer(home: Home): Container! {
    let dev = base.withExec(["apk", "add", "--no-cache", "yarn"])
    if (home != null) {
      dev = home.install(dev)
    }
    withBuildkit(dev)
      .withExec([
        "go", "install",
        "github.com/Kunde21/markdownfmt/v3/cmd/markdownfmt@latest",
      ])
      .withFile("/usr/bin/bass", build.file("bass"))
      .withDirectory("/src", ws.directory(".", gitignore: true))
      .withWorkdir("/src")
      .withDefaultTerminalCmd(["bash"])
  }

  """
  Start a dev shell.
  """
  dev: Container! {
    devContainer.terminal
  }

  """
  Get the build pipeline.
  """
  pipeline: Pipeline! {
    Pipeline(bass: self)
  }
}

"""
Something that can set up a dev container, e.g. dotfiles.
"""
interface Home {
  install(base: Container!): Container!
}

type Pipeline {
  let bass: Bass!

  """
  Build for all platforms.
  """
  build: Dist! {
    Dist(
      linuxAmd64: bass
        .build(goos: "linux", goarch: "amd64")
        .file("bass"),
      linuxArm64: bass
        .build(goos: "linux", goarch: "arm64")
        .file("bass"),
      darwinArm64: bass
        .build(goos: "darwin", goarch: "arm64")
        .file("bass"),
      windowsAmd64: bass
        .build(goos: "windows", goarch: "amd64")
        .file("bass.exe"),
    )
  }

  """
  Run unit tests.
  """
  unit: UnitTested! {
    bass.unit(["./..."], goTestFlags: ["-race"])
    UnitTested(output: "ok")
  }

  """
  Run integration tests.
  """
  integration: IntegrationTested! {
    bass.integration(runtime: "").sync
    IntegrationTested(output: "ok")
  }

  """
  Ship a release.
  """
  ship(
    dist: Dist!,
    unit: UnitTested!,
    integ: IntegrationTested!,
    githubToken: Secret!,
  ): Void {
    null
  }
}

type Dist {
  linuxAmd64: File!
  linuxArm64: File!
  darwinArm64: File!
  windowsAmd64: File!
}

type UnitTested {
  output: String!
}

type IntegrationTested {
  output: String!
}
